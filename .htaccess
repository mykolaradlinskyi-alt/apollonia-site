# ============ АПОЛЛОНІЯ — apollonia.ua ============

# Кастомна 404-сторінка
ErrorDocument 404 /404.html

# Відключити лістинг папок (щоб /assets/photos/ не показував список файлів)
Options -Indexes

# ============ HTTP → HTTPS + www → apex + старі URL → hotel.apollonia.ua ============
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Старі WordPress-URLи готелю → новий поддомен (зберігає SEO-вагу)
  # Йде ПЕРШИМ, щоб HTTP-запит на старий URL ішов одним hop'ом на hotel.apollonia.ua
  RewriteRule ^apollonia_hotel/?$ https://hotel.apollonia.ua/ [R=301,L]
  RewriteRule ^apollonia_hotel/(.*)$ https://hotel.apollonia.ua/$1 [R=301,L]

  # Якщо запит прийшов по HTTP — редирект на HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # www.apollonia.ua → apollonia.ua
  RewriteCond %{HTTP_HOST} ^www\.apollonia\.ua$ [NC]
  RewriteRule ^(.*)$ https://apollonia.ua/$1 [R=301,L]
</IfModule>

# ============ КЕШУВАННЯ СТАТИКИ ============
<IfModule mod_expires.c>
  ExpiresActive On

  # Картинки — рік (хеш у назві файлу не використовуємо, але контент не міняється)
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # CSS/JS (немає окремих файлів, але про всяк випадок)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"

  # HTML — година (щоб правки доходили швидше)
  ExpiresByType text/html "access plus 1 hour"

  # XML (sitemap) — день
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
</IfModule>

# ============ GZIP-КОМПРЕСІЯ ============
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/xml text/plain
  AddOutputFilterByType DEFLATE application/javascript application/xml application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ============ БЕЗПЕКА ============
<IfModule mod_headers.c>
  # HSTS — кажемо браузеру 30 днів пам'ятати, що сайт лише HTTPS.
  # Підняти до 31536000 (рік) після того, як упевнимось, що все стабільно.
  Header always set Strict-Transport-Security "max-age=2592000; includeSubDomains" env=HTTPS

  # Заборонити вбудовування сайту в iframe (захист від clickjacking)
  Header set X-Frame-Options "SAMEORIGIN"
  # Заборонити MIME-sniffing
  Header set X-Content-Type-Options "nosniff"
  # Referrer policy для приватності
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Заборонити прямий доступ до прихованих файлів
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
